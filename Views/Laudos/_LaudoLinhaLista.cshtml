@model SgdBaldan.Models.Laudo
@using SgdBaldan.Services
@{
    var operador = ViewData["EhOperador"] as bool? ?? false;
    var naFila = operador && LaudoFluxo.NaFilaDoOperador(Model);
    var tipoTxt = Model.Tipo == TipoLaudo.Liberacao ? "Liberação" : Model.Tipo == TipoLaudo.Preventiva ? "Preventiva" : "Corretiva";
    var tipoPill = Model.Tipo == TipoLaudo.Liberacao ? "pill--ok" : Model.Tipo == TipoLaudo.Preventiva ? "pill--info" : "pill--redo";
    var criador = User.IsInRole(Papeis.Projetista) || User.IsInRole(Papeis.Operacional);
    var rotuloAcao = "Abrir";
    if (criador && Model.Status == StatusLaudo.EmAndamento) rotuloAcao = "Continuar";
    else if (criador && Model.Status == StatusLaudo.Reprovado) rotuloAcao = "Refazer";
    else if (operador && Model.Status == StatusLaudo.AguardandoOperador) rotuloAcao = "Preencher";
    else if (User.IsInRole(Papeis.Programador) && Model.Status == StatusLaudo.AguardandoAprovacao) rotuloAcao = "Analisar";
    var busca = (Model.Dispositivo.Codigo + " " + Model.Dispositivo.Produto.Nome + " " + Model.OrdemServico).ToLowerInvariant();
}
<tr data-busca="@busca">
  <td>@Model.Dispositivo.Codigo<div class="sub nota">OS @Model.OrdemServico</div></td>
  <td>@Model.Dispositivo.Produto.Nome</td>
  <td><span class="pill @tipoPill">@tipoTxt</span></td>
  <td>@Model.DataAtualizacao.ToString("dd/MM/yyyy HH:mm")</td>
  <td><span class="pill @Model.Status.ClassePill()">@Model.Status.Rotulo()</span></td>
  <td>
    <div class="row-actions">
      @if (naFila)
      {
          <form method="post" action="@Url.Content("~/laudos/" + Model.IdLaudo + "/assumir")">@Html.AntiForgeryToken()<button class="btn sm" type="submit">Assumir</button></form>
      }
      else
      {
          <a class="btn sm" href="@Url.Content("~/laudos/" + Model.IdLaudo)">@rotuloAcao</a>
      }
    </div>
  </td>
</tr>
