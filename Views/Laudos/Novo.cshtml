@model SgdBaldan.ViewModels.LaudoNovoViewModel
@{ ViewData["Title"] = "Novo laudo"; }
<section class="container py-4"><h1>Novo laudo</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="post" action="/laudos/novo">
@Html.AntiForgeryToken()
<div class="mb-3"><label asp-for="Tipo">Tipo</label><select asp-for="Tipo" asp-items="Html.GetEnumSelectList<SgdBaldan.Models.Enums.TipoLaudo>()" class="form-select"></select></div>
<div class="mb-3"><label asp-for="Modo">Modo</label><select asp-for="Modo" asp-items="Html.GetEnumSelectList<SgdBaldan.Models.Enums.ModoLaudo>()" class="form-select"></select></div>
<div class="mb-3"><label asp-for="IdDispositivo">Dispositivo</label><select asp-for="IdDispositivo" class="form-select"><option value="">Selecione</option>@foreach(var d in Model.Dispositivos){<option value="@d.IdDispositivo">@d.Codigo — @d.Produto.Nome</option>}</select></div>
<div class="mb-3"><label asp-for="OrdemServico">Ordem de serviço</label><input asp-for="OrdemServico" class="form-control" /></div>
<div class="mb-3"><label asp-for="DataInicio">Data</label><input asp-for="DataInicio" type="date" class="form-control" /></div>
<button class="btn btn-primary" type="submit">Criar laudo</button> <a href="/laudos">Cancelar</a>
</form></section>
