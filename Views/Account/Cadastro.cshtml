@model CadastroViewModel
@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Solicitar acesso";
    var msgClasse = ViewData["MsgOk"] is true ? "signup-message success" : "signup-message";
    var msg = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).FirstOrDefault() ?? ViewData["Msg"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cadastro.css" asp-append-version="true" />
}

<main class="login">
  <section class="hero" aria-hidden="true">
    <div class="hero__machine"><img src="~/img/LogoSite.png" alt=""></div>
    <span class="hero__shape hero__shape--solid"></span>
    <div class="hero__text"><p class="hero__slogan">Mais controle.<br>Menos paradas.</p><span>V 0.1</span><span class="hero__bar"></span></div>
  </section>
  <section class="access">
    <div class="card signup-card">
      <header class="brand">
        <img src="~/img/LogoBaldan.png" alt="" class="brand__icon">
        <span class="brand__name">SGD</span><span class="brand__divider"></span>
        <span class="brand__desc">Sistema de Gestão<br>de Dispositivos</span>
      </header>
      <h1 class="title">Solicitar <span>acesso</span></h1>
      <p class="subtitle">Preencha seus dados. A Gestão avaliará sua solicitação.</p>
      <form id="cadastroForm" class="form" asp-controller="Account" asp-action="Cadastro" method="post" novalidate>
        <div class="field"><label class="field__icon" for="nome"><span class="sr-only">Nome</span> N</label><input id="nome" name="Nome" value="@Model.Nome" type="text" maxlength="100" placeholder="Nome completo" autocomplete="name" required></div>
        <div class="field"><label class="field__icon" for="re"><span class="sr-only">RE</span> RE</label><input id="re" name="Re" value="@Model.Re" type="text" maxlength="30" placeholder="Registro (RE)" autocomplete="username" required></div>
        <div class="field"><label class="field__icon" for="senha"><span class="sr-only">Senha</span> <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></label><input id="senha" name="Senha" type="password" minlength="8" placeholder="Senha (mínimo 8 caracteres)" autocomplete="new-password" required></div>
        <div class="field"><label class="field__icon" for="perfil"><span class="sr-only">Perfil solicitado</span> P</label>
          <select id="perfil" name="PerfilSolicitado" required>
            <option value="">Selecione o perfil de acesso</option>
            <option value="Projetista">Projetista</option>
            <option value="Operacional">Operacional</option>
            <option value="Gerente">Gerente (somente consulta)</option>
            <option value="Programador">Programador</option>
          </select>
        </div>
        <p class="signup-help">O acesso só será liberado após aprovação da Gestão.</p>
        <p id="cadastroMsg" class="@msgClasse" role="alert" hidden="@(string.IsNullOrEmpty(msg))">@msg</p>
        <div class="signup-actions"><a class="link" href="~/">Voltar ao login</a><button class="btn" type="submit">Enviar solicitação</button></div>
      </form>
    </div>
  </section>
</main>
