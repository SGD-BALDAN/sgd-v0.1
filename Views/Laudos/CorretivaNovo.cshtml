@model LaudoFormViewModel
@{
    ViewData["Title"] = Model.Novo ? "Novo laudo de corretiva" : "Laudo de corretiva";
    ViewData["Tema"] = "t-red";
    ViewData["Nav"] = "dispositivos";
    var edita = Model.PodeEditarEstrutura;
    var fotos = Model.PodeEditarEstrutura || Model.PodePreencher;
    var acaoForm = Model.Novo ? Url.Content("~/laudos/corretiva/novo") : Url.Content("~/laudos/" + Model.IdLaudo + "/salvar");
    var causas = System.Text.Json.JsonSerializer.Serialize(new
    {
        metodo = Model.CausasMetodo, maquina = Model.CausasMaquina, material = Model.CausasMaterial,
        medicao = Model.CausasMedicao, meioAmbiente = Model.CausasMeioAmbiente, maoDeObra = Model.CausasMaoDeObra,
        causaRaiz = Model.CausaRaiz ?? ""
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/corretiva-novo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/laudo-medicoes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/laudo-form.css" asp-append-version="true" />
}

<main><form id="f" class="page-form" method="post" enctype="multipart/form-data" action="@acaoForm" data-leitura="@(Model.SomenteLeitura ? "true" : "false")" data-estrutura="@(Model.PodeEditarEstrutura ? "true" : "false")" novalidate>
 @Html.AntiForgeryToken()
 <a class="back" href="~/laudos/corretiva"><span data-ic="back"></span>Voltar</a>
 <div class="head"><span class="badge-ic" data-ic="file"></span><div><h1>@(Model.Novo ? "Novo laudo de corretiva" : "Laudo de corretiva")</h1><p class="sub">Registre a falha, analise a causa raiz utilizando o método Ishikawa e descreva as ações corretivas.</p></div>@if (!Model.Novo) { <span class="sp"></span><span class="pill @Model.Status.ClassePill()">@Model.Status.Rotulo()</span> }</div>
 @await Html.PartialAsync("_LaudoAvisos", Model)
 <div class="split">
  <section class="card"><h2><span data-ic="file"></span>Informações gerais</h2><div class="fg">
   @await Html.PartialAsync("_LaudoCampos", Model)
  </div></section>

 </div>

 
 <section class="card sgd-desenho"><h2><span data-ic="file"></span>Desenho técnico</h2>
  @await Html.PartialAsync("_LaudoDesenho", Model)</section>
 @await Html.PartialAsync("_LaudoMedidas", Model)
 @await Html.PartialAsync("_LaudoChecklist", Model)
 <!-- MODIFICACAO POR CAIO BONONI CASO DER TUDO ERRADO -->
  
<section class="card sgd-corretiva-ocorrencia-container">

    <h2>
        <span data-ic="file"></span>
        Registro da Ocorrência
    </h2>

    <!-- PRIMEIRA LINHA -->
    <div class="sgd-corretiva-ocorrencia-layout">

        <!-- INFORMAÇÕES DA FALHA -->
        <div class="sgd-corretiva-ocorrencia-informacoes">

            <p class="sub card__lead">Informações da falha</p>

            <div class="f">
                <label for="descricao_falha">
                    Descrição da falha encontrada <i>*</i>
                </label>

                <textarea
                    id="descricao_falha"
                    name="DescricaoFalha"
                    maxlength="1500"
                    required
                    readonly="@(!edita)"
                    placeholder="Descreva detalhadamente o problema identificado no dispositivo...">@Model.DescricaoFalha</textarea>
            </div>

            <div class="sgd-corretiva-ocorrencia-controle-voz">

                <button type="button" class="btn pri" id="btnVozOcorrencia">
                    <span data-ic="mic"></span>
                    Ditar descrição por voz
                </button>

                <button type="button" class="btn" id="btnAnalisarOcorrencia">
                    Analisar com IA
                </button>

            </div>

            <small id="statusVozOcorrencia"></small>

        </div>

        <div class="sgd-corretiva-ocorrencia-fotografias">

            <p class="sub card__lead">Foto da Situação Atual</p>

            <div class="sgd-corretiva-ocorrencia-botoes-foto">
<!--
                <label
                    class="sgd-corretiva-ocorrencia-area-upload"
                    for="cameraOcorrencia">

                    <span data-ic="camera"></span>
                     
            
                    <strong>Tirar foto</strong>
                    <small>Utilizar a câmera do dispositivo</small>

                    <input
                        type="file"
                        id="cameraOcorrencia"
                        accept="image/*"
                        capture="environment"
                        hidden>
                </label>
-->
                <label
                    class="sgd-corretiva-ocorrencia-area-upload"
                    for="uploadOcorrencia">

                    <span data-ic="image-plus"></span>
                    <strong>Enviar imagem</strong>
                    <small>Selecionar uma foto existente</small>

                    @if (fotos)
                    {
                    <input
                        type="file"
                        id="uploadOcorrencia"
                        name="FotosOcorrencia"
                        accept="image/*"
                        multiple
                        hidden>
                    }
                </label>

            </div>

            <div
                id="previewOcorrencia"
                class="sgd-corretiva-ocorrencia-visualizacao">
                @foreach (var foto in Model.FotosOcorrenciaAtuais)
                {
                    <img src="@Url.Content("~/laudos/anexos/" + foto.IdAnexo + "/download")" alt="@foto.NomeOriginal" title="@foto.NomeOriginal" class="foto-salva">
                }
            </div>

        </div>

    </div>

    <!-- SUGESTÕES DA IA -->
    <div class="sgd-corretiva-ocorrencia-ia">

        <p class="sub card__lead">
            Sugestões da IA — revise antes de confirmar
        </p>

        <div class="sgd-corretiva-ocorrencia-ia-layout">

            <div class="f">
                <label for="componente_afetado">
                    Componente afetado
                </label>

                <input
                    type="text"
                    id="componente_afetado"
                    name="ComponenteAfetado"
                    value="@Model.ComponenteAfetado"
                    maxlength="150"
                    readonly="@(!edita)"
                    placeholder="Componente identificado pela análise">
            </div>

            <div class="f">
                <label for="tipo_falha">
                    Tipo de falha
                </label>

                <select id="tipo_falha" name="TipoFalha" disabled="@(!edita)">
                    <option value="">Selecione o tipo de falha</option>
                    @foreach (var tf in Enum.GetValues<TipoFalha>())
                    {
                        <option value="@tf" selected="@(Model.TipoFalha == tf)">@tf.Rotulo()</option>
                    }
                </select>
            </div>

            <div class="f">
                <label for="causas_sugeridas">
                    Possíveis causas raízes
                </label>

                <textarea
                    id="causas_sugeridas"
                    name="CausasSugeridas"
                    maxlength="1500"
                    readonly="@(!edita)"
                    placeholder="Possíveis causas sugeridas pela IA...">@Model.CausasSugeridas</textarea>
            </div>

        </div>

        <small class="sgd-corretiva-ocorrencia-aviso">
            As sugestões são preliminares e devem ser avaliadas pelo responsável.
            Nenhuma causa raiz será considerada comprovada automaticamente.
        </small>

    </div>

</section>
 
 <div class="split">
  <section class="card sgd-ishikawa">
   <div class="sgd-ishikawa__header">
    <div>
     <h2><span data-ic="wrench"></span>Análise de causa raiz — Ishikawa</h2>
     <p class="sub card__lead">Utilize o método 6M para identificar e organizar as possíveis causas da falha.</p>
    </div>
    <span class="sgd-ishikawa__badge">Método 6M</span>
   </div>
   <div class="sgd-ishikawa__scroll">
    <div class="fish" id="fish" data-causas="@causas" data-edita="@(edita ? "true" : "false")"></div>
   </div>
   <div class="sgd-ishikawa__footer">
    <span class="sgd-ishikawa__legend-dot"></span>
    Adicione as possíveis causas e depois defina a causa raiz principal.
   </div>
  </section>
  <section class="card"><h2>IA assistente de causa raiz</h2><p class="sub ia__lead">Descreva o que aconteceu e deixe a IA resumir o ocorrido e sugerir possíveis causas raiz.</p>
   <div class="ia"><button type="button" id="ia-mic" class="btn pri"><span data-ic="mic"></span>Falar com a IA</button><button type="button" id="ia-txt" class="btn">Digitar descrição manual</button>
   <textarea id="relato" name="relato" hidden placeholder="Descreva o que aconteceu…" aria-label="Relato"></textarea>
   <div class="card ia__summary"><b>Resumo sugerido pela IA</b><p class="sub" id="resumo">Após a análise do relato, a IA irá sugerir possíveis causas raiz com base no histórico e nas boas práticas da ferramentaria.</p></div></div></section>
 </div>
 <section class="card"><div class="head head--flush"><h2><span data-ic="wrench"></span>Plano de Ação Corretiva</h2><span class="sp"></span>@if (edita) { <button type="button" id="addA" class="btn sm"><span data-ic="plus"></span>Adicionar ação</button> }</div><div id="acts" class="actions-list" data-rows>
  @for (var i = 0; i < Model.Acoes.Count; i++)
  {
      @await Html.PartialAsync("_LaudoLinhaAcao", new LinhaAcaoModel { Indice = i.ToString(), Item = Model.Acoes[i], Edita = edita })
  }
 </div>
 @if (edita)
 {
     <template id="tplAcao">@await Html.PartialAsync("_LaudoLinhaAcao", new LinhaAcaoModel { Indice = "__I__", Item = new AcaoForm(), Edita = true })</template>
 }
 </section>

 <!-- MODIFICACAO POR CAIO BONONI CASO DER TUDO ERRADO -->
 <!-- FOTO DO TRABALHO REALIZADO -->
<section class="card sgd-corretiva-foto-trabalho">

    <h2>
        <span data-ic="camera"></span>
        Foto do Trabalho Realizado
    </h2>

    <div class="sgd-corretiva-ocorrencia-fotografias">

        <div class="sgd-corretiva-ocorrencia-botoes-foto">

            <!-- CÂMERA 
            <label
                class="sgd-corretiva-ocorrencia-area-upload"
                for="cameraTrabalho">

                <span data-ic="camera"></span>
                <strong>Tirar foto</strong>
                <small>Utilizar a câmera do dispositivo</small>

                <input
                    type="file"
                    id="cameraTrabalho"
                    accept="image/*"
                    capture="environment"
                    hidden>
            </label>-->

            <!-- UPLOAD -->
            @if (fotos)
            {
            <label
                class="sgd-corretiva-ocorrencia-area-upload"
                for="uploadTrabalho">

                <span data-ic="image-plus"></span>
                <strong>Enviar imagem</strong>
                <small>Selecionar uma foto existente</small>

                <input
                    type="file"
                    id="uploadTrabalho"
                    name="FotosTrabalho"
                    accept="image/*"
                    multiple
                    hidden>
            </label>
            }

        </div>

        <!-- PRÉ-VISUALIZAÇÃO -->
        <div
            id="previewTrabalho"
            class="sgd-corretiva-ocorrencia-visualizacao">
            @foreach (var foto in Model.FotosTrabalhoAtuais)
            {
                <img src="@Url.Content("~/laudos/anexos/" + foto.IdAnexo + "/download")" alt="@foto.NomeOriginal" title="@foto.NomeOriginal" class="foto-salva">
            }
        </div>

    </div>

</section>

 <!-- MODIFICACAO POR CAIO BONONI CASO DER TUDO ERRADO -->




 <!-- DESENHO TÉCNICO / MEDIDAS / CHECKLIST (mesmas seções do laudo de liberação) -->

 <section class="card"><div class="f"><label for="obs">Outras informações</label><textarea id="obs" name="OutrasInformacoes" maxlength="1500" readonly="@(!edita)" placeholder="Observações, anexos ou registros adicionais">@Model.OutrasInformacoes</textarea></div></section>
 @await Html.PartialAsync("_LaudoRodape", Model)
</form></main>

@section Scripts {
    <script src="~/js/laudo-form.js" asp-append-version="true"></script>
}
