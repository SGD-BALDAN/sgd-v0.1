@model LaudoFormViewModel
@{
    ViewData["Title"] = Model.Novo ? "Novo laudo de Preventiva" : "Laudo de Preventiva";
    ViewData["Tema"] = "t-blue";
    ViewData["Nav"] = "dispositivos";
    ViewData["TextoVazio"] = "Nenhum desenho importado...";
    var acaoForm = Model.Novo ? Url.Content("~/laudos/preventiva/novo") : Url.Content("~/laudos/" + Model.IdLaudo + "/salvar");
}

@section Styles {
    <link rel="stylesheet" href="~/css/liberacao-novo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/preventiva-novo.inline.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/laudo-form.css" asp-append-version="true" />
}

<main>

      <form id="f" class="page-form" method="post" enctype="multipart/form-data" action="@acaoForm" data-leitura="@(Model.SomenteLeitura ? "true" : "false")" data-estrutura="@(Model.PodeEditarEstrutura ? "true" : "false")" novalidate>
        @Html.AntiForgeryToken()

        <a class="back" href="~/laudos/preventiva">
          <span data-ic="back"></span>
          Voltar
        </a>

        <!-- CABEÇALHO -->
        <div class="head">

          <span class="badge-ic" data-ic="cal"></span>

          <div>
            <h1>@(Model.Novo ? "Novo laudo de Preventiva" : "Laudo de Preventiva")</h1>
            <p class="sub">
              Preencha as informações do laudo conforme o desenho técnico e valide o dispositivo.
            </p>
          </div>
          @if (!Model.Novo) { <span class="sp"></span><span class="pill @Model.Status.ClassePill()">@Model.Status.Rotulo()</span> }

        </div>

        @await Html.PartialAsync("_LaudoAvisos", Model)

        <!-- INFORMAÇÕES GERAIS -->
        <div class="split">

       <section class="card"><h2><span data-ic="cal"></span>Informações gerais</h2><div class="fg">
   @await Html.PartialAsync("_LaudoCampos", Model)
  </div></section>

        </div>

        <!-- DESENHO TÉCNICO -->
        <div class="split split--drawing">

          <section class="card">

            <h2>
              <span data-ic="cal"></span>
              Desenho técnico
            </h2>

            @await Html.PartialAsync("_LaudoDesenho", Model)

          </section>

        </div>

        <!-- MEDIDAS E ESPECIFICAÇÕES -->
        @await Html.PartialAsync("_LaudoMedidas", Model)

        <!-- CHECKLIST -->
        @await Html.PartialAsync("_LaudoChecklist", Model)

        <!-- AÇÕES -->
        @await Html.PartialAsync("_LaudoRodape", Model)

      </form>

    </main>

@section Scripts {
    <script src="~/js/laudo-form.js" asp-append-version="true"></script>
}
