@model SgdBaldan.ViewModels.LaudoEditarViewModel
@using SgdBaldan.Models.Enums
@{ ViewData["Title"] = "Laudo " + Model.Laudo.IdLaudo; var l=Model.Laudo; }
<section class="container py-4"><h1>Laudo #@l.IdLaudo — @l.Tipo</h1>
<p>Dispositivo: @l.Dispositivo.Codigo | Modo: @l.Modo | Status: <strong>@l.Status</strong></p>
@if(TempData["Sucesso"] is string s){<div class="alert alert-success">@s</div>} @if(TempData["Erro"] is string e){<div class="alert alert-danger">@e</div>}
@if(Model.PodeEditarEstrutura){
<form method="post" action="/laudos/@l.IdLaudo/estrutura">@Html.AntiForgeryToken()
<h2>Medidas e especificações (M6-05)</h2>
@for(int i=0;i<Math.Max(3,l.Medidas.Count);i++){var m=i<l.Medidas.Count?l.Medidas[i]:null;<div class="row g-2 mb-2"><input type="hidden" name="Medidas[@i].Numero" value="@(m?.Numero??i+1)"/><div class="col"><select name="Medidas[@i].Descricao" class="form-select"><option value="">Descrição</option>@foreach(var v in Enum.GetValues<DescricaoMedida>()){<option value="@v" selected="@(m?.Descricao==v)">@v</option>}</select></div><div class="col"><input class="form-control" name="Medidas[@i].Especificacao" placeholder="50 ± 0,5" value="@m?.Especificacao"/></div><div class="col"><select class="form-select" name="Medidas[@i].MetodoInstrumento"><option value="">Instrumento</option>@foreach(var v in Enum.GetValues<MetodoInstrumento>()){<option value="@v" selected="@(m?.MetodoInstrumento==v)">@v</option>}</select></div></div>}
<h2>Checklist (M6-06)</h2>
@for(int i=0;i<Math.Max(3,l.Checklist.Count);i++){var c=i<l.Checklist.Count?l.Checklist[i]:null;<div class="mb-2"><input class="form-control" name="ItensChecklist[@i].Descricao" value="@c?.Descricao" placeholder="Descrição do item @(@i+1)"/><input type="hidden" name="ItensChecklist[@i].Numero" value="@(c?.Numero??i+1)"/></div>}
@if(l.Tipo==TipoLaudo.Corretiva){<h2>Corretiva / Ishikawa 6M (M6-09)</h2><textarea name="DescricaoFalha" class="form-control mb-2" placeholder="Descrição da falha">@l.Corretiva?.DescricaoFalha</textarea><input name="ComponenteAfetado" class="form-control mb-2" placeholder="Componente afetado" value="@l.Corretiva?.ComponenteAfetado"/><textarea name="CausasSugeridas" class="form-control mb-2" placeholder="Campos de IA armazenados sem execução">@l.Corretiva?.CausasSugeridas</textarea>
@{var ish=l.Corretiva?.Ishikawa;} @foreach(var campo in new[]{("Metodo","Método",ish?.Metodo),("Maquina","Máquina",ish?.Maquina),("Material","Material",ish?.Material),("Medicao","Medição",ish?.Medicao),("MeioAmbiente","Meio ambiente",ish?.MeioAmbiente),("MaoDeObra","Mão de obra",ish?.MaoDeObra)}){<label>@campo.Item2</label><textarea class="form-control mb-2" name="@campo.Item1">@campo.Item3</textarea>}<input class="form-control mb-2" name="CausaRaiz" placeholder="Causa raiz" value="@ish?.CausaRaiz"/>}
<button class="btn btn-primary" type="submit">Salvar estrutura</button></form>}
@if(Model.PodePreencher){<form method="post" action="/laudos/@l.IdLaudo/preenchimento">@Html.AntiForgeryToken()<h2>Preenchimento do operador (M6-04)</h2>
@foreach(var m in l.Medidas){<div class="mb-2"><label>@m.Descricao — @m.Especificacao (mín. @m.LimiteMin / máx. @m.LimiteMax)</label><input type="hidden" name="Medicoes.Index" value="@m.IdMedida"/><input type="hidden" name="Medicoes[@m.IdMedida].IdMedida" value="@m.IdMedida"/><input class="form-control" type="number" step="0.0001" name="Medicoes[@m.IdMedida].Medicao" value="@m.Medicao"/></div>}
@foreach(var c in l.Checklist){<div class="mb-2"><label>@c.Descricao</label><input type="hidden" name="ResultadosChecklist.Index" value="@c.IdChecklist"/><input type="hidden" name="ResultadosChecklist[@c.IdChecklist].IdChecklist" value="@c.IdChecklist"/><select class="form-select" name="ResultadosChecklist[@c.IdChecklist].Resultado"><option value="Ok">OK</option><option value="NaoOk">NÃO OK</option><option value="Na">N/A</option></select></div>}
<button class="btn btn-primary">Salvar preenchimento</button></form>}
<form method="post" action="/laudos/@l.IdLaudo/enviar" class="my-3">@Html.AntiForgeryToken()<button class="btn btn-success">Enviar laudo</button></form>
@if(l.Status==StatusLaudo.Reprovado){<p><strong>Motivo da reprovação:</strong> @l.Historico.OrderByDescending(x=>x.DataHora).FirstOrDefault(x=>!string.IsNullOrEmpty(x.Motivo))?.Motivo</p><form method="post" action="/laudos/@l.IdLaudo/reenviar">@Html.AntiForgeryToken()<button class="btn btn-warning">Reabrir para correção</button></form>}
@if(l.Status==StatusLaudo.AguardandoAprovacao){<form method="post" action="/laudos/@l.IdLaudo/aprovar" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-success">Aprovar</button></form><form method="post" action="/laudos/@l.IdLaudo/reprovar" class="d-inline">@Html.AntiForgeryToken()<input name="motivo" required placeholder="Motivo da reprovação"/><button class="btn btn-danger">Reprovar</button></form>}
<h2>Histórico</h2><ul>@foreach(var h in l.Historico.OrderByDescending(x=>x.DataHora)){<li>@h.DataHora — @h.Status — @h.Usuario?.Nome — @h.Motivo</li>}</ul>
<form method="post" action="/laudos/@l.IdLaudo/reaproveitar">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary">Reaproveitar estrutura</button></form>
<form method="post" action="/laudos/@l.IdLaudo/excluir" class="mt-2">@Html.AntiForgeryToken()<button class="btn btn-outline-danger">Excluir (somente EmAndamento)</button></form>
</section>
