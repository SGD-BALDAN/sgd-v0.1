@model LaudoFormViewModel
@{
    ViewData["Title"] = Model.Novo ? "Novo laudo de liberação" : "Laudo de liberação";
    ViewData["Tema"] = "t-green";
    ViewData["Nav"] = "dispositivos";
    var acaoForm = Model.Novo ? Url.Content("~/laudos/liberacao/novo") : Url.Content("~/laudos/" + Model.IdLaudo + "/salvar");
}

@section Styles {
    <link rel="stylesheet" href="~/css/liberacao-novo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/liberacao-novo.inline.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/laudo-form.css" asp-append-version="true" />
}

<main><form id="f" class="page-form" method="post" enctype="multipart/form-data" action="@acaoForm" data-leitura="@(Model.SomenteLeitura ? "true" : "false")" data-estrutura="@(Model.PodeEditarEstrutura ? "true" : "false")" novalidate>
 @Html.AntiForgeryToken()
 <a class="back" href="~/laudos/liberacao"><span data-ic="back"></span>Voltar</a>
 <div class="head"><span class="badge-ic" data-ic="file"></span><div><h1>@(Model.Novo ? "Novo laudo de liberação" : "Laudo de liberação")</h1><p class="sub">Preencha as informações do laudo conforme o desenho técnico e valide o dispositivo.</p></div>@if (!Model.Novo) { <span class="sp"></span><span class="pill @Model.Status.ClassePill()">@Model.Status.Rotulo()</span> }</div>
 @await Html.PartialAsync("_LaudoAvisos", Model)
 <div class="split">
  <section class="card"><h2><span data-ic="file"></span>Informações gerais</h2><div class="fg">
   @await Html.PartialAsync("_LaudoCampos", Model)
  </div></section>
 </div>
 <div class="split split--drawing">
  <section class="card"><h2><span data-ic="file"></span>Desenho técnico</h2>
   @await Html.PartialAsync("_LaudoDesenho", Model)</section>
  @await Html.PartialAsync("_LaudoMedidas", Model)
 </div>
 @await Html.PartialAsync("_LaudoChecklist", Model)
 @await Html.PartialAsync("_LaudoRodape", Model)
</form></main>

@section Scripts {
    <script src="~/js/laudo-form.js" asp-append-version="true"></script>
}
