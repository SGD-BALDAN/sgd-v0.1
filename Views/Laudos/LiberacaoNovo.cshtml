@{
    ViewData["Title"] = "Novo laudo de liberação";
    ViewData["Tema"] = "t-green";
    ViewData["Nav"] = "dispositivos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/liberacao-novo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/liberacao-novo.inline.css" asp-append-version="true" />
}

<main><form id="f" class="page-form" novalidate>
 <a class="back" href="~/laudos/liberacao"><span data-ic="back"></span>Voltar</a>
 <div class="head"><span class="badge-ic" data-ic="file"></span><div><h1>Novo laudo de liberação</h1><p class="sub">Preencha as informações do laudo conforme o desenho técnico e valide o dispositivo.</p></div></div>
 <div class="split">
  <section class="card"><h2><span data-ic="file"></span>Informações gerais</h2><div class="fg">
   <div class="f"><label for="cod">Número do Dispositivo <i>*</i></label><input id="cod" name="codigo" placeholder="Ex.: DMP010100" required></div>
   <div class="f"><label for="prod">Produto <i>*</i></label><select id="prod" name="produto" required data-produtos><option value="">Selecione o produto</option></select></div>
   <div class="f"><label for="dt">⦁	Data de início  <i>*</i></label><input id="dt" name="data" type="date" required></div>
   <div class="f"><label for="os">Ordem de serviço <i>*</i></label><input id="os" name="os" placeholder="Ex.: OS-000123" required></div>
   <div class="f">
    <label for="rm">Responsável pela manutenção <i>*</i></label>
    <input type="text" id="rm" name="resp_manut" placeholder=" Nome do Responsável" disabled>
</div>
 <div class="f"><label for="tipo">Tipo <i>*</i></label><select id="tipo" name="tipo" required data-tipos><option value="">Selecione o tipo</option></select></div>
  </div></section>
  <!--<section class="card"><h2>Amostra</h2>
   <label class="radio"><input type="radio" name="amostra" value="liberacao" checked>Liberação</label>
   <label class="radio"><input type="radio" name="amostra" value="corretiva">Corretiva</label>
   <label class="radio"><input type="radio" name="amostra" value="preventiva">Preventiva</label></section>-->
 </div>
 <div class="split split--drawing">
  <section class="card"><h2><span data-ic="file"></span>Desenho técnico</h2>
   <label class="drop"><span data-ic="up"></span><b>Importar desenho boleado</b><span id="prev">Nenhum desenho importado. O desenho servirá de referência para as medidas.</span><input id="file" type="file" accept="image/*,.pdf" hidden></label></section>
  <section class="card"><div class="head head--flush"><h2>Medidas / especificações</h2><span class="sp"></span><button type="button" id="addM" class="btn sm"><span data-ic="plus"></span>Adicionar medida</button></div>
   <div class="tw mt"><table class="tbl"><thead><tr><th>Nº</th><th>Descrição</th><th>Especificação</th><th>Mínimo</th><th>Máximo</th><th>Método / instrumento</th><th>Medição</th><th>Resultado</th><th><span class="sr-only">Remover</span></th></tr></thead><tbody id="medidas" data-rows></tbody></table></div></section>
 </div>
 <section class="card"><div class="head head--flush"><h2>Checklist</h2><span class="sp"></span><button type="button" id="addC" class="btn sm"><span data-ic="plus"></span>Adicionar item</button></div>
  <div class="tw mt"><table class="tbl"><thead><tr><th>Nº</th><th>Descrição</th><th>Resultado</th><th><span class="sr-only">Remover</span></th></tr></thead><tbody id="check" data-rows></tbody></table></div></section>
 <div class="actions"><a class="btn" href="~/laudos/liberacao"><span data-ic="x"></span>Cancelar</a><button class="btn" type="submit"><span data-ic="save"></span>Salvar laudo</button><button class="btn pri" type="button" id="concluir"><span data-ic="file"></span>Concluir e enviar</button></div>
</form></main>
