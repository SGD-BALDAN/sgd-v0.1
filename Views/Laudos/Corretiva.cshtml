@{
    ViewData["Title"] = "Corretiva";
    ViewData["Tema"] = "t-red";
    ViewData["Nav"] = "inicio";
    ViewData["Tipo"] = "corretiva";
}

@section Styles {
    <link rel="stylesheet" href="~/css/laudos-lista.css" asp-append-version="true" />
}

<main>
 <a class="back" href="~/inicio"><span data-ic="back"></span>Laudos</a>
 <div class="head"><span class="badge-ic" data-ic="wrench"></span><div><h1>Corretiva</h1><p class="sub">Confira os laudos corretivos em andamento e gerencie novos registros.</p></div><span class="sp"></span><a class="btn pri" id="novo" href="~/laudos/corretiva/novo"><span data-ic="plus"></span>Novo laudo</a></div>
 <p class="banner" id="aviso" role="status" hidden></p>
 <section class="stats">
  <div class="stat"><span data-ic="file"></span><div><small>Em andamento</small><b id="sAnd">0</b></div></div>
  <div class="stat"><span data-ic="clock"></span><div><small>Aguardando gestão aprovar</small><b id="sPend">0</b></div></div>
  <div class="stat"><span data-ic="warn"></span><div><small>Refazer laudo</small><b id="sRedo">0</b></div></div>
  <div class="stat"><span data-ic="target"></span><div><small>Aprovados</small><b id="sApr">0</b></div></div>
  <div class="stat"><div><small>Fila de laudos</small><b id="sUso">0%</b><small id="sUsoTxt"></small></div></div>
 </section>
 <div class="head"><h2>Meus laudos <span class="pill pill--count" id="n">0</span></h2><span class="sp"></span>
  <label class="search"><span data-ic="search"></span><input id="q" placeholder="Buscar por número do dispositivo ou produto…" aria-label="Buscar"></label></div>
 <div class="tw"><table><thead><tr><th>Número do Dispositivo</th><th>Produto</th><th>Tipo</th><th>Última atualização</th><th>Status</th><th>Ações</th></tr></thead><tbody id="rows"></tbody></table></div>
</main>
